# ── Who's house-hunting ──────────────────────────────────────────
# Comma-separated names shown in the "who's looking" switch.
HOUSEHOLD_MEMBERS=Gokul,Laura

# Optional shared passcode. When set, the app asks for it once per device.
# Strongly recommended if you host this anywhere other than your own laptop.
APP_PASSCODE=

# Where properties, photos and renders are stored (JSON + image files).
DATA_DIR=./data

# ── Claude (reads floor plans, imports listings, suggests ideas) ─
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5.
CLAUDE_MODEL=

# ── Image model (photo re-imagining + photoreal renders of 3D views) ─
# Set ONE of these. Gemini is preferred if both are present; override with IMAGE_PROVIDER.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_PROVIDER=
